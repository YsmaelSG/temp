diff --git a/docs/PR_DESCRIPTION.md b/docs/PR_DESCRIPTION.md
new file mode 100644
index 0000000..8c14d89
--- /dev/null
+++ b/docs/PR_DESCRIPTION.md
@@ -0,0 +1,14 @@
+# PR #42: Transaction categories + monthly spending summary
+
+Implements `docs/SPEC_categories.md`.
+
+## Changes
+- `Transaction` gets a `category` field (defaults to `other`, so existing rows load fine)
+- `POST /api/transactions` accepts an optional `category`, validated against the allowed list
+- New `PATCH /api/transactions/<id>` to re-categorize a transaction
+- New `GET /api/accounts/<id>/summary?month=YYYY-MM` with per-category totals
+- Renamed `created_at` → `date` in transaction responses; the frontend PR will use this name
+- Tests for create, re-categorize, and summary
+
+## Testing
+`pytest` passes (15 tests). Also tried the summary endpoint locally with curl.
diff --git a/tests/test_categories.py b/tests/test_categories.py
new file mode 100644
index 0000000..dc12e62
--- /dev/null
+++ b/tests/test_categories.py
@@ -0,0 +1,28 @@
+def test_create_with_category(client):
+    res = client.post("/api/transactions", json={
+        "account_id": "acc_1", "type": "debit", "amount_cents": 800, "category": "dining",
+    })
+    assert res.status_code == 201
+    assert res.get_json()["category"] == "dining"
+
+
+def test_create_with_invalid_category(client):
+    res = client.post("/api/transactions", json={
+        "account_id": "acc_1", "type": "debit", "amount_cents": 800, "category": "pizza",
+    })
+    assert res.status_code == 422
+
+
+def test_recategorize_transaction(client):
+    res = client.patch("/api/transactions/txn_2", json={"category": "dining"})
+    assert res.status_code == 200
+    assert res.get_json()["category"] == "dining"
+
+
+def test_monthly_summary(client):
+    client.patch("/api/transactions/txn_2", json={"category": "dining"})
+    res = client.get("/api/accounts/acc_1/summary?month=2026-08")
+    assert res.status_code == 200
+    body = res.get_json()
+    assert body["totals_cents"]["dining"] == 1250
+    assert body["total_spent_cents"] == 101250
