+        totals = {c: 0 for c in CATEGORIES}
+        for txn_id in self.txn_ids_by_account[account_id]:
+            txn = self.transactions[txn_id]
+            if txn.type == "debit" and txn.created_at.startswith(month + "-"):
+                totals[txn.category] += txn.amount_cents
+        return totals
+
+    def set_category(self, txn_id: str, category: str) -> Transaction | None:
+        with self._lock:
+            txn = self.transactions.get(txn_id)
+            if txn is None:
+                return None
+            path = self._path("category_changes.csv")
+            is_new = not os.path.exists(path)
+            with open(path, "a", newline="") as f:
+                writer = csv.DictWriter(f, fieldnames=CATEGORY_CHANGE_FIELDS)
+                if is_new:
+                    writer.writeheader()
+                writer.writerow({
+                    "txn_id": txn_id,
+                    "category": category,
+                    "changed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+                })
+            txn.category = category  # memory updated only after the write succeeds
+            return txn
